# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Gemini text model override. Defaults to gemini-3.6-flash with fallback.
GEMINI_MODEL=gemini-3.6-flash

# Optional Gemini image model override. Used by Book Studio page image generation.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Midtrans
# Launch default: manual. Change both values only when Midtrans production is ready.
PAYMENT_PROVIDER=manual
ENABLE_MIDTRANS=false
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY

# Manual payments. QRIS defaults below point to fixed-amount assets bundled with the app.
MANUAL_PAYMENT_BANK_NAME=YOUR_BANK_NAME
MANUAL_PAYMENT_ACCOUNT_NUMBER=YOUR_ACCOUNT_NUMBER
MANUAL_PAYMENT_ACCOUNT_HOLDER=YOUR_ACCOUNT_HOLDER
MANUAL_PAYMENT_QRIS_15000_URL=/payments/qris/qris-15k.png
MANUAL_PAYMENT_QRIS_25000_URL=/payments/qris/qris-25k.png
MANUAL_PAYMENT_QRIS_VIP_100000_URL=/payments/qris/qris-vip-100k.png
MANUAL_PAYMENT_QRIS_MANUAL_URL=/payments/qris/qris-manual.png
MANUAL_PAYMENT_EXPIRES_HOURS=24
ADMIN_REVIEWER_NAME=Admin BacaYuk

# WhatsApp Business Cloud API notification sent after a buyer uploads proof.
# Create and approve the pesanan_baru_bacayuk template before enabling it.
WHATSAPP_CLOUD_API_VERSION=
WHATSAPP_CLOUD_API_ACCESS_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_RECIPIENT=62XXXXXXXXXXX
WHATSAPP_PAYMENT_REVIEW_TEMPLATE=pesanan_baru_bacayuk
WHATSAPP_PAYMENT_REVIEW_TEMPLATE_LANGUAGE=id

# DANA QRIS Acquirer. Sandbox callback verification uses DANA's documented
# sandbox public key by default. Disabled unless explicitly set to true.
DANA_QRIS_ENABLED=false
DANA_ENV=sandbox
DANA_API_BASE_URL=https://api.sandbox.dana.id
DANA_X_PARTNER_ID=
DANA_MERCHANT_ID=
DANA_STORE_ID=bacayuk-web
DANA_CHANNEL_ID=95221
DANA_ORIGIN=https://bacayuk.web.id
DANA_QRIS_EXPIRES_MINUTES=30
DANA_PRIVATE_KEY=
# DANA's public key for webhook verification. Sandbox uses the official
# documented key built into the server; this variable is needed for production.
DANA_PUBLIC_KEY=

# Customer AI story maker stays locked until the product is ready.
AI_STORY_MAKER_ENABLED=false

# Admin PIN: Required for admin access to the applet. Keep server-side only.
ADMIN_PIN=YOUR_ADMIN_PIN

# Database configuration
VITE_SUPABASE_URL=YOUR_DATABASE_URL
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only Supabase key for admin CMS writes. Never expose this with VITE_.
SUPABASE_SECRET_KEY=YOUR_SERVICE_ROLE_KEY
# Public contact shown on the legal/privacy page. Ensure this mailbox is active.
VITE_LEGAL_CONTACT_EMAIL=privacy@bacayuk.web.id
